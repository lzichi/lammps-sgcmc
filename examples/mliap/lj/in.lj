python make_model here """
import sys
sys.path.insert(0, '../../../python')
import numpy as np
from lammps.mliap.mliap_unified_lj import MLIAPUnifiedLJ

class OutputLJ(MLIAPUnifiedLJ):
    def compute_forces(self, data):
        rij = data.rij
        if isinstance(rij, np.ndarray):
            xp = np
        else:
            import cupy as xp
        r2inv = 1.0 / xp.sum(rij * rij, axis=1)
        r6inv = r2inv ** 3
        eij = 4.0 * r6inv * (r6inv - 1.0)
        fij = (12.0 * r6inv * (1.0 - 2.0 * r6inv) * r2inv)[:, None] * rij
        data.update_pair_energy(eij)
        data.update_pair_forces(fij)
        per_atom_energy = xp.bincount(data.pair_i, weights=0.5 * eij,
                                      minlength=data.nlocal)[:data.nlocal]
        if xp is not np:
            per_atom_energy = xp.asnumpy(per_atom_energy)
        data.set_custom_output('lj_energy', per_atom_energy)

def make_model():
    OutputLJ(['Ar']).pickle('model.pkl')
"""
python make_model invoke

units lj
atom_style atomic
newton on

lattice fcc 0.8442
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box
mass 1 1.0

pair_style mliap unified model.pkl 0
pair_coeff * * Ar

fix motion all nve
fix output all pair 1 mliap lj_energy 0
compute energy all pe/atom
dump atoms all custom 1 atoms.dump id f_output c_energy

run 1
